{
  "name": "fumpad-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sdk": "tsc -b ../services/sdk && rm -f vendor/fumpad-sdk-*.tgz && npm pack ../services/sdk --pack-destination vendor && npm install --no-audit --no-fund ./vendor/fumpad-sdk-*.tgz",
    "fumi": "node scripts/fumi-assets.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@fumpad/sdk": "file:vendor/fumpad-sdk-0.7.0.tgz",
    "@noble/curves": "^1.9.7",
    "@privy-io/react-auth": "^3.48.1",
    "@solana-program/memo": "^0.15.0",
    "@solana-program/system": "^0.15.0",
    "@solana-program/token": "^0.17.0",
    "@solana/kit": "^8.4.0",
    "@solana/web3.js": "^1.99.0",
    "next": "16.4.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
