{
  "name": "fumpad-services",
  "private": true,
  "type": "module",
  "workspaces": [
    "sdk",
    "meteora",
    "engine",
    "indexer",
    "api",
    "keeper"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b sdk meteora engine indexer api keeper",
    "typecheck": "tsc -b sdk meteora engine indexer api keeper && tsc -p tsconfig.scripts.json",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "sync-idl": "node scripts/sync-idl.mjs",
    "local": "tsx scripts/local-e2e.ts",
    "validator": "tsx scripts/local/dev-chain.ts",
    "api-types": "node scripts/gen-api-types.mjs",
    "test:all": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
