{
  "name": "fumpad-services",
  "private": true,
  "type": "module",
  "workspaces": [
    "sdk",
    "meteora",
    "engine",
    "indexer",
    "api",
    "keeper"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b sdk meteora engine indexer api keeper",
    "typecheck": "tsc -b sdk meteora engine indexer api keeper && tsc -p tsconfig.scripts.json",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "sync-idl": "node scripts/sync-idl.mjs",
    "local": "tsx scripts/local-e2e.ts",
    "local:app": "tsx scripts/local/app-stack.ts",
    "validator": "tsx scripts/local/dev-chain.ts",
    "bootstrap:rehearsal": "tsx scripts/local/bootstrap-rehearsal.ts",
    "multisig:rehearsal": "tsx scripts/local/multisig-rehearsal.ts",
    "mainnet:rehearsal": "tsx scripts/mainnet/rehearsal.ts",
    "mainnet:bootstrap": "tsx scripts/mainnet/bootstrap-mainnet.ts",
    "mainnet:snapshot": "tsx scripts/mainnet/fork.ts snapshot",
    "mainnet:compare": "tsx scripts/mainnet/fork.ts compare",
    "mainnet:build-program": "tsx scripts/mainnet/build-program.ts",
    "rpc-check": "tsx scripts/ops/rpc-check.ts",
    "pinata-check": "tsx scripts/ops/pinata-check.ts",
    "api-types": "node scripts/gen-api-types.mjs",
    "test:all": "vitest run"
  },
  "devDependencies": {
    "@sqds/multisig": "^2.1.4",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "4.1.12"
  }
}
